{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "string"
            }
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "migrations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coordinator": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          }
        }
      }
    },
    "controlPlane": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "dnk-common": {
      "type": "object"
    }
  }
}
