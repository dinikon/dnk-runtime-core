# Local development settings
DEPLOY_ENV=DEVELOPMENT
COMMIT_SHA=dev
PROJECT__VERSION=

# Docker local runtime
API_PORT=8000

# Runtime schema defaults
SCHEMA_PREFIX=dnk_
DEFAULT_SEED_MODULE=src.modules.schema_registry.seed.schema_seed

# Database connection parts for server-based databases (default: PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=dniko
DB_CHARSET=
DB_EXTRAS=
SQLALCHEMY_DATABASE_URI_SCHEME=postgresql+asyncpg

SQLALCHEMY_POOL_SIZE=0
SQLALCHEMY_MAX_OVERFLOW=0
SQLALCHEMY_POOL_RECYCLE=0
SQLALCHEMY_POOL_USE_LIFO=false
SQLALCHEMY_POOL_PRE_PING=false
SQLALCHEMY_ECHO=true

DB_STARTUP_MAX_ATTEMPTS=5
DB_STARTUP_RETRY_DELAY_SECONDS=1

RETRIEVAL_SERVICE_EXECUTORS=2

# Identity auth settings
AUTH__OTP_CODE_LENGTH=6
AUTH__OTP_TOKEN_TTL_SECONDS=300
AUTH__SESSION_TTL_SECONDS=432000
AUTH__SESSION_COOKIE_NAME=dnk_session

# Email delivery
EMAIL__PROVIDER=smtp
EMAIL__FROM_ADDRESS=no-reply@example.com
EMAIL__FROM_NAME=DNK Runtime
EMAIL__SMTP__HOST=localhost
EMAIL__SMTP__PORT=25
EMAIL__SMTP__USERNAME=
EMAIL__SMTP__PASSWORD=
EMAIL__SMTP__USE_TLS=false
EMAIL__SMTP__USE_STARTTLS=false
EMAIL__SMTP__TIMEOUT_SECONDS=10

# Control plane server-to-server auth
CONTROL_PLANE_API_KEY=

# Redis configuration for OTP and session token storage
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_USE_SSL=false
REDIS_DB=0

# RabbitMQ shared connection
RABBITMQ_USERNAME=rabbitmq
RABBITMQ_PASSWORD=rabbitmq
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ__ENABLED=false
RABBITMQ__URL=amqp://guest:guest@localhost:5672/
RABBITMQ__PUBLISHER_CONFIRMS=true
RABBITMQ__PREFETCH=20

# MinIO object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Shared integration event bus
EVENT_BUS__EXCHANGE_NAME=dnk.integration.events
EVENT_BUS__PUBLISH_LIMIT=100
EVENT_BUS__RETRY_BASE_SECONDS=30
EVENT_BUS__MAX_ATTEMPTS=5

# Long-running outbox publisher
EVENT_BUS__PUBLISHER_WORKER_ENABLED=false
EVENT_BUS__PUBLISHER_IDLE_SLEEP_SECONDS=0.5
EVENT_BUS__PUBLISHER_ERROR_SLEEP_SECONDS=5.0

# Debug integration events console worker
EVENTS_CONSOLE_QUEUE_NAME=dnk.integration.events.console
EVENTS_CONSOLE_ROUTING_KEY=#

# Communication outbound delivery queue
COMMUNICATION_QUEUE__ENABLED=false
COMMUNICATION_QUEUE__EXCHANGE_NAME=communication.outbound
COMMUNICATION_QUEUE__QUEUE_NAME=communication.outbound.send
COMMUNICATION_QUEUE__ROUTING_KEY=send
COMMUNICATION_QUEUE__PREFETCH=20
COMMUNICATION_QUEUE__WORKERS=10
COMMUNICATION_QUEUE__PROCESSING_LEASE_SECONDS=300
COMMUNICATION_QUEUE__REPUBLISH_AFTER_SECONDS=60

# Shared scheduled jobs
SCHEDULED_JOBS__PROCESS_LIMIT=100
SCHEDULED_JOBS__RECOVER_LIMIT=100
SCHEDULED_JOBS__LOCK_TTL_SECONDS=300
SCHEDULED_JOBS__RETRY_BASE_SECONDS=30
SCHEDULED_JOBS__MAX_ATTEMPTS=5
