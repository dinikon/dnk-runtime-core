# Mount in the CORE frontend image at /etc/nginx/templates/default.conf.template.
# Nginx's entrypoint substitutes CORE_DOMAIN. Mount certificates read-only at /etc/nginx/tls.
server {
    listen 80;
    server_name ${CORE_DOMAIN};
    return 308 https://${CORE_DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${CORE_DOMAIN};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    resolver 127.0.0.11 valid=5s ipv6=off;
    set $core_backend http://core:8001;
    set $core_web http://core-web:3000;

    # The backend is reachable only on the private container network.
    # Replace client-supplied forwarding headers at this trusted boundary.
    location ~ ^/(api|accounts|admin|static)(/|$) {
        proxy_pass $core_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass $core_web;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
