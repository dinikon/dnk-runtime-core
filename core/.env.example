# Local development only. Generate a key as described in README.md.
CORE_SECRET_KEY=
CORE_DEBUG=true
CORE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORE_PUBLIC_ORIGIN=http://localhost:8080
CORE_TRUST_PROXY=false
# The local Nginx gateway is one trusted hop; direct runserver has zero.
CORE_TRUSTED_PROXY_COUNT=0

# Generate once with Fernet.generate_key(); mandatory for production.
# Development derives a stable fallback from CORE_SECRET_KEY if this is empty.
CORE_MFA_ENCRYPTION_KEY=

# Without Docker, match the existing runtime database and credentials.
# Compose supplies these values from the root DB_* configuration automatically.
# Django uses only the core schema through its connection search_path.
CORE_DB_NAME=dniko
CORE_DB_USER=postgres
CORE_DB_PASSWORD=
CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=5432

# Compose supplies the existing Redis service. Direct local development can use
# an in-process cache; production requires a shared Redis connection.
CORE_REDIS_HOST=127.0.0.1
CORE_REDIS_PORT=6379
CORE_REDIS_PASSWORD=
CORE_REDIS_DB=1
# Optional redis:// or rediss:// override; URL-encode credentials when using it.
CORE_REDIS_URL=

# This explicit backend prints mail to Django logs, regardless of DEBUG.
# To send mail, change it to django.core.mail.backends.smtp.EmailBackend.
# SMTP is the production default only when CORE_EMAIL_BACKEND is unset.
CORE_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CORE_EMAIL_HOST=localhost
CORE_EMAIL_PORT=587
CORE_EMAIL_HOST_USER=
CORE_EMAIL_HOST_PASSWORD=
CORE_EMAIL_USE_TLS=false
CORE_EMAIL_USE_SSL=false
# Keep certificate validation enabled. A development-only compatibility mode is
# available with accounts.mail.SMTPEmailBackend; see README before changing this.
CORE_EMAIL_VERIFY_CERTIFICATE=true
CORE_DEFAULT_FROM_EMAIL=dNiko Alpha <noreply@localhost>

# Provider buttons appear only when credentials are configured.
CORE_GOOGLE_CLIENT_ID=
CORE_GOOGLE_CLIENT_SECRET=
CORE_GITHUB_CLIENT_ID=
CORE_GITHUB_CLIENT_SECRET=

# Codes are delivered in Telegram, never by SMS. Empty token disables phone login.
CORE_TELEGRAM_GATEWAY_TOKEN=
CORE_TELEGRAM_GATEWAY_TIMEOUT=5

# The Nuxt server uses this for canonical and Open Graph URLs.
NUXT_PUBLIC_SITE_URL=http://localhost:8080

# Telegram Login (OIDC), independent of Telegram Gateway delivery.
# Register the exact callback URL in BotFather; keep its default RS256 signing.
# https://your-core-domain/accounts/oidc/telegram/login/callback/
CORE_TELEGRAM_LOGIN_CLIENT_ID=
CORE_TELEGRAM_LOGIN_CLIENT_SECRET=

# Optional local browser-test outbox; used only with the filebased backend.
# CORE_EMAIL_FILE_PATH=/tmp/core-e2e-mail
