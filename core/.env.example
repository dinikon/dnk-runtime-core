# Конфигурация CORE. Секреты не добавляйте в Git.
# Приоритет: аргументы load_config > окружение процесса > core/.env > defaults.
# Изменения применяются перезапуском процесса; Compose требует force-recreate.
# CORE_ENV_FILE задаётся в окружении процесса, не здесь: путь к другому dotenv;
# default — абсолютный core/.env, пустое CORE_ENV_FILE= отключает файл для тестов.

# Приложение, HTTP и сессии
# Постоянный секрет подписи Django; непустая строка, default отсутствует (обязателен). Не менять при каждом запуске.
CORE_SECRET_KEY=
# Режим разработки; true/false, default false. Пример включает локальный режим; production требует false и HTTPS.
CORE_DEBUG=true
# Разрешённые Host через запятую; default — hostname публичного origin. В production запрещён *.
CORE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Публичный origin со схемой и портом, без пути; default в debug http://localhost:8000, в production обязателен HTTPS.
CORE_PUBLIC_ORIGIN=http://localhost:8080
# Доверять HTTPS-заголовку настроенного reverse proxy; true/false, default false. Включать только за доверенным proxy.
CORE_TRUST_PROXY=false
# Число доверенных proxy перед Django; целое >=0, default 0; локальный gateway Compose задаёт 1.
CORE_TRUSTED_PROXY_COUNT=0
# Срок запомненной сессии в секундах; число >0, default 1209600 (14 дней).
CORE_SESSION_COOKIE_AGE=1209600
# Запоминать сессию; auto/true/false, default auto (выбирает пользователь). При true/false checkbox отсутствует.
CORE_SESSION_REMEMBER=auto
# Язык интерфейса Django; код локали, default ru. Используйте локаль с установленными переводами.
CORE_LANGUAGE_CODE=ru
# Часовой пояс; валидное имя IANA, default UTC, например Europe/Kyiv.
CORE_TIME_ZONE=UTC

# Username: generated — внутренний идентификатор создаётся автоматически; required — пользователь выбирает его при регистрации. Default: generated. Вход по username доступен только в required при разрешённом входе по паролю; ФИО заполняется в обоих режимах.
CORE_AUTH_USERNAME_MODE=generated

# Авторизация и создание аккаунтов
# Политика основного входа/регистрации: passwordless/optional/required, default passwordless. optional/passwordless требуют email-кода; reauth и управление паролем сохраняются.
CORE_AUTH_PASSWORD_MODE=passwordless
# Создание обычных, социальных и passkey-аккаунтов; true/false, default true. Не удаляет существующих пользователей.
CORE_AUTH_SIGNUP_ENABLED=true
# Первичный вход по email-коду; true/false, default true. Нельзя отключать в optional/passwordless.
CORE_AUTH_EMAIL_CODE_ENABLED=true
# Первичный вход с passkey; true/false, default true. Не отменяет проверку ранее подключённой MFA.
CORE_AUTH_PASSKEY_LOGIN_ENABLED=true
# Регистрация с passkey; true/false, default true. Требует открытой регистрации, разрешённых ключей и passkey-входа; резервные коды выдаются обязательно.
CORE_AUTH_PASSKEY_SIGNUP_ENABLED=true
# Срок login/phone OTP и доставки Gateway в секундах; 30..3600, default 300. Один срок у allauth и Gateway.
CORE_AUTH_CODE_TIMEOUT=300
# Попытки ввода login/phone OTP; целое 1..10, default 3.
CORE_AUTH_CODE_MAX_ATTEMPTS=3
# Повторная отправка login/phone OTP; true/false, default true. Лимиты запросов продолжают действовать.
CORE_AUTH_CODE_RESEND_ENABLED=true
# Срок обязательного подтверждения email кодом в секундах; >0, default 900.
CORE_EMAIL_VERIFICATION_TIMEOUT=900
# Повторные отправки кода подтверждения email; целое >=0, default 2. При 0 повторная отправка запрещена.
CORE_EMAIL_VERIFICATION_MAX_RESENDS=2
# Попытки ввода кода подтверждения email; целое 1..10, default 3.
CORE_EMAIL_VERIFICATION_MAX_ATTEMPTS=3
# Срок свежего подтверждения личности перед чувствительным действием, секунды >0; default 300.
CORE_REAUTHENTICATION_TIMEOUT=300
# Срок email-кода повторного подтверждения, секунды >0; default 300. Независим от первичного email-входа.
CORE_EMAIL_REAUTHENTICATION_TIMEOUT=300
# Минимальный интервал между email-кодами reauth, секунды >0; default 30. Применяется через лимиты allauth.
CORE_EMAIL_REAUTHENTICATION_RESEND_WAIT_SECONDS=30
# Максимум email-кодов reauth на пользователя за час; целое >0, default 5.
CORE_EMAIL_REAUTHENTICATION_MAX_PER_HOUR=5
# Попытки email-кода повторного подтверждения; целое 1..10, default 3.
CORE_EMAIL_REAUTHENTICATION_MAX_ATTEMPTS=3

# Подключение MFA; существующие факторы продолжают проверяться
# Подключение нового TOTP; true/false, default true. Не отключает уже включённый TOTP.
CORE_MFA_TOTP_ENROLLMENT_ENABLED=true
# Добавление новых ключей; true/false, default true. При false также отключите passkey signup.
CORE_MFA_PASSKEY_ENROLLMENT_ENABLED=true
# Название сервиса в приложении TOTP; непустая строка, default dNiko Alpha.
CORE_MFA_TOTP_ISSUER=dNiko Alpha
# Постоянный ключ Fernet для MFA; default пусто (debug выводит стабильный ключ из CORE_SECRET_KEY). В production обязателен; смена ломает расшифровку существующих факторов.
CORE_MFA_ENCRYPTION_KEY=

# PostgreSQL: все таблицы Django остаются в схеме core
# Имя общей базы PostgreSQL; непустая строка, default dniko. Compose переопределяет из корневого DB_DATABASE.
CORE_DB_NAME=dniko
# Пользователь PostgreSQL; непустая строка, default postgres. Compose переопределяет из DB_USERNAME.
CORE_DB_USER=postgres
# Пароль PostgreSQL; строка, default пусто. Compose переопределяет из DB_PASSWORD.
CORE_DB_PASSWORD=
# Хост или путь сокета PostgreSQL; default 127.0.0.1. Compose задаёт postgres.
CORE_DB_HOST=127.0.0.1
# Порт PostgreSQL; целое 1..65535, default 5432.
CORE_DB_PORT=5432

# Redis: отдельный префикс dnk:core для лимитов allauth
# Хост Redis; default пусто (в debug разрешён локальный cache). Production требует Redis; Compose задаёт redis.
CORE_REDIS_HOST=127.0.0.1
# Порт Redis; целое 1..65535, default 6379.
CORE_REDIS_PORT=6379
# Пароль Redis; строка, default пусто. Для отдельного поля URL-кодирование не требуется.
CORE_REDIS_PASSWORD=
# Индекс базы Redis; целое >=0, default приложения 2; пример и Compose используют 1.
CORE_REDIS_DB=1
# Полный redis:// или rediss:// URL; default пусто. Непустое значение важнее отдельных Redis-полей; credentials в URL должны быть URL-encoded.
CORE_REDIS_URL=

# Почта: backend выбирается независимо от заполненных SMTP credentials
# Django backend (Python import path); default console в debug, SMTP в production. console только печатает письма; для отправки задайте django.core.mail.backends.smtp.EmailBackend или accounts.mail.SMTPEmailBackend.
CORE_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SMTP-хост, совпадающий с именем в сертификате; default localhost.
CORE_EMAIL_HOST=localhost
# SMTP-порт; целое 1..65535, default 587. Обычно 465 для SSL или 587 для STARTTLS.
CORE_EMAIL_PORT=587
# SMTP-логин; строка, default пусто. Обычно полный адрес почтового ящика.
CORE_EMAIL_HOST_USER=
# SMTP-пароль; секретная строка, default пусто. Используется только SMTP backend.
CORE_EMAIL_HOST_PASSWORD=
# STARTTLS; true/false, default false в debug и true в production. Несовместим с SSL=true.
CORE_EMAIL_USE_TLS=false
# TLS сразу при соединении; true/false, default false. Для порта 465 обычно true вместе с TLS=false.
CORE_EMAIL_USE_SSL=false
# Проверка SMTP-сертификата; true/false, default true. false только для debug и backend accounts.mail.SMTPEmailBackend.
CORE_EMAIL_VERIFY_CERTIFICATE=true
# Таймаут SMTP в секундах; число >0, default 10.
CORE_EMAIL_TIMEOUT=10
# Каталог filebased outbox; default core/mail-outbox. Используется только filebased backend, для изолированных браузерных тестов.
CORE_EMAIL_FILE_PATH=
# Адрес отправителя; default dNiko Alpha <noreply@localhost>. Для SMTP укажите разрешённый сервером адрес.
CORE_DEFAULT_FROM_EMAIL=dNiko Alpha <noreply@localhost>
# Префикс темы account-писем; строка, default '[dNiko Alpha] '. Кавычки сохраняют пробел в конце.
CORE_EMAIL_SUBJECT_PREFIX='[dNiko Alpha] '
# Уведомления безопасности аккаунта; true/false, default true. Обязательные коды подтверждения не отключаются.
CORE_EMAIL_NOTIFICATIONS=true

# Google и GitHub: при auto кнопки появляются только с обоими credentials
# Google Login; auto/true/false, default auto. true требует client ID и secret, false запрещает вход и callback.
CORE_GOOGLE_LOGIN_ENABLED=auto
# Google OAuth client ID; строка, default пусто. Работает вместе с client secret.
CORE_GOOGLE_CLIENT_ID=
# Google OAuth secret; секретная строка, default пусто. Не передаётся во frontend.
CORE_GOOGLE_CLIENT_SECRET=
# GitHub Login; auto/true/false, default auto. true требует client ID и secret.
CORE_GITHUB_LOGIN_ENABLED=auto
# GitHub OAuth client ID; строка, default пусто. Работает вместе с client secret.
CORE_GITHUB_CLIENT_ID=
# GitHub OAuth secret; секретная строка, default пусто. Не передаётся во frontend.
CORE_GITHUB_CLIENT_SECRET=

# Telegram Login (OIDC): отдельный сценарий, не доставка кода
# Telegram OIDC Login; auto/true/false, default auto. true требует оба credentials; не зависит от Gateway.
CORE_TELEGRAM_LOGIN_ENABLED=auto
# Telegram OIDC client ID; строка, default пусто. Callback: /accounts/oidc/telegram/login/callback/.
CORE_TELEGRAM_LOGIN_CLIENT_ID=
# Telegram OIDC secret; секретная строка, default пусто. Настройте точный callback у провайдера.
CORE_TELEGRAM_LOGIN_CLIENT_SECRET=

# Telegram Gateway: код приходит в Telegram, не SMS
# Телефонный вход через Gateway; auto/true/false, default auto (включён при токене). true требует токен; независимо от Telegram Login.
CORE_TELEGRAM_GATEWAY_ENABLED=auto
# Токен Gateway; секретная строка, default пусто. Отправка только для подтверждённых телефонов существующих пользователей.
CORE_TELEGRAM_GATEWAY_TOKEN=
# Таймаут HTTP-запроса Gateway в секундах; число >0, default 5. TTL доставки задаётся CORE_AUTH_CODE_TIMEOUT.
CORE_TELEGRAM_GATEWAY_TIMEOUT=5

# Nuxt читает своё окружение отдельно от Django
# Публичный URL для canonical/Open Graph Nuxt; default http://localhost:8080. CoreSettings игнорирует NUXT_*; Compose задаёт URL frontend отдельно.
NUXT_PUBLIC_SITE_URL=http://localhost:8080
