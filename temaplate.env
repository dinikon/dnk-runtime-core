# Common application settings
COMMIT_SHA=

# Database connection parts for server-based databases (default: PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=dniko
DB_CHARSET=
DB_EXTRAS=
SQLALCHEMY_DATABASE_URI_SCHEME=postgresql+asyncpg

# Leave empty to build the URI from DB_* settings above.
# Example: postgresql+asyncpg://postgres:postgres@localhost:5432/dniko
SQLALCHEMY_DATABASE_URI=

SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_POOL_USE_LIFO=false
SQLALCHEMY_POOL_PRE_PING=false
SQLALCHEMY_ECHO=false

RETRIEVAL_SERVICE_EXECUTORS=4
